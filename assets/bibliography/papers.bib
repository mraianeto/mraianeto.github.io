@article{perez2023generalized,
  abbr = {EPJC},
  title = {A new solution for a generalized cosmological wormhole},
  author = {P{\'e}rez, Daniela and Raia Neto, M{\'a}rio},
  journal = {The European Physical Journal C},
  volume = {83},
  number = {12},
  pages = {1127},
  year = {2023},
  month = dec,
  publisher = {Springer},
  doi = {10.1140/epjc/s10052-023-12316-x},
  arxiv = {2312.07736},
  pdf = {cw.pdf},
  preview = {cosmological_wormhole.png},
  preview_dark = {cosmological_wormhole_dark.png},
  bibtex_show = {true},
  abstract = {We find a new exact solution to Einstein field equations that represents a cosmological wormhole embedded in a flat Friedmann-Lemaitre-Robertson-Walker universe. The new metric is a generalization of a previous cosmological wormhole solution found by Kim. We explicitly show that the flaring out condition is satisfied at the throat at all cosmic times; in addition, the null energy condition is violated at the throat regardless of the background cosmological model; thus, the spacetime geometry presented here describes a wormhole coupled to the cosmic dynamics that exists at all cosmic times and whose throat remains open in any cosmological model.}
}

@article{raia2023shadow,
  abbr = {IJMPD},
  title = {The Shadow of Charged Traversable Wormholes},
  author = {Raia Neto, M{\'a}rio and P{\'e}rez, Daniela and Pelle, Joaquin},
  journal = {International Journal of Modern Physics D},
  volume = {32},
  number = {02},
  pages = {2250137},
  year = {2023},
  month = jan,
  publisher = {World Scientific},
  doi = {10.1142/S0218271822501371},
  arxiv = {2210.14106},
  pdf = {ctwh.pdf},
  preview = {wormhole_shadow.png},
  bibtex_show = {true},
  selected = {true},
  abstract = {We compute the shadow cast by a charged Morris-Thorne wormhole when the light source is a star located beyond the mouth which is opposite to the observer. First, we provide an extensive analysis of the geodesic properties of the spacetime, both for null and massive particles. The geometrical properties of this solution are such that independently of the viewing angle, some light rays always reach the observer. Additionally, the structure of the images is preserved among the different values of the charge and scales proportionally to the charge value.}
}

@article{raia2022rotating,
  abbr = {BSAB},
  title = {Rotating Spacetimes},
  author = {Raia Neto, M{\'a}rio and Botti, Luiz Claudio Lima},
  journal = {Boletim da Sociedade Astron{\^o}mica Brasileira},
  volume = {33},
  year = {2022},
  month = oct,
  html = {https://sab-astro.org.br/sab/publicacoes/boletim-da-sab-vol-33/},
  pdf = {sab2022.pdf},
  preview = {rotating_spacetimes.png},
  preview_dark = {rotating_spacetimes_dark.png},
  bibtex_show = {true},
  abstract = {We studied important theoretical facts about black holes such as the frame-dragging phenomena and the basic structure of Kerr black holes, and we discussed that rotation increases the violation of energy conditions on wormholes and warp drives rotating.}
}
