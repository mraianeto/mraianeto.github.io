@misc{raia2026relativistic,
  abbr = {Seminar},
  title = {Relativistic Corrections in Radiative Transfer of Black Hole Accretion Disks},
  author = {Raia Neto, M{\'a}rio},
  howpublished = {Seminar, MSc course Radiative Processes (Prof. Anderson Caproni), N{\'u}cleo de Astrof{\'i}sica, University of the City of S{\~a}o Paulo (UNICID)},
  year = {2026},
  month = nov,
  note = {Every ray-traced image in the slides was computed with ipole (Mo{\'s}cibrodzka \& Gammie 2018).},
  slides_versions = {Full deck v2, 60 pages | slides/relativistic-disks-full-v2.pdf ;
                     Full deck v1, 66 pages | slides/relativistic-disks-full.pdf ;
                     30-minute seminar, 34 pages | slides/relativistic-disks-30.pdf ;
                     25 minutes, 29 pages | slides/relativistic-disks-25.pdf ;
                     20 minutes, 24 pages | slides/relativistic-disks-20.pdf ;
                     15 minutes, 18 pages | slides/relativistic-disks-15.pdf},
  slides_open = {true},
  preview = {relativistic_disks_ipole.png},
  abstract = {How special and general relativity change the light we receive from a geometrically thin, optically thick accretion disk around a black hole. Starting from Newtonian radiative transfer, the talk adds, one at a time, Doppler shift and beaming, gravitational redshift and light bending in the Kerr spacetime, and shows their consequences: the inner edge at the ISCO, the dependence of disk images and spectra on spin and inclination, and the broad, skewed Fe K-alpha line. The practical application is the polarized general-relativistic radiative transfer code ipole (Mo{\'s}cibrodzka \& Gammie 2018): its covariant transfer scheme, its tests, and our own disk and RIAF images.}
}

@techreport{raia2025madtopologies,
  abbr = {CAMK},
  title = {Different Magnetic Field Topologies in Black Hole MAD Accretion Disk Simulations},
  author = {Raia Neto, M{\'a}rio},
  institution = {Nicolaus Copernicus Astronomical Center, Polish Academy of Sciences},
  type = {Course report},
  year = {2025},
  month = apr,
  address = {Warsaw, Poland},
  note = {Report for the course "Numerical simulations of accretion discs" (Professors: Miljenko {\v{C}}emelji{\'c} and Debora Lan{\v{c}}ov{\'a}).},
  pdf = {maddisks.pdf},
  preview = {mad_topologies.png},
  bibtex_show = {true},
  abstract = {Understanding the impact of magnetic field topology on the evolution of black hole accretion disks is essential for interpreting high-energy astrophysical phenomena such as jet formation and relativistic outflows. This work presents a comparative study of two different magnetic configurations, dipolar and multipolar, in the context of Magnetically Arrested Disks (MADs), using two-dimensional general relativistic magnetohydrodynamic (GRMHD) simulations carried out with the iharm3d code. Both setups are based on a modified Fishbone-Moncrief torus in Kerr spacetime, where vector potentials define distinct initial magnetic field structures. We analyze within a low resolution simulation, the time evolution of key physical fluxes (mass accretion rate, magnetic flux, angular momentum flux, and energy extraction efficiency) measured near the event horizon. The results show that dipolar configurations lead to a more stable and efficient MAD state, whereas multipolar topologies generate irregular accretion patterns and lower energy extraction.}
}
